# CI image: Python 3.13 + inference group pre-installed from poetry.lock.
# Rebuilt automatically when Dockerfile.ci, pyproject.toml, or poetry.lock changes.
FROM python:3.13-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    make git libxcb1 libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/* \
    && git config --system --add safe.directory '*'

COPY pyproject.toml poetry.lock ./

RUN pip install --no-cache-dir poetry \
    && poetry config virtualenvs.create false \
    && poetry install --only inference --no-interaction --no-root \
    && pip uninstall -y poetry
